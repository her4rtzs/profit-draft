# ProFit environment variables (names only; no real secrets here).
# Copy to .env for local development. .env is git-ignored.

# Django crypto signing key. Required in production. Leave unset locally to use the dev-insecure fallback.
SECRET_KEY=

# Debug mode. Defaults off. Set to True for local development.
DEBUG=

# Host header allow-list (CSV). Required when DEBUG=False (startup fails fast if unset).
# Include your Vercel domain and any custom domains, e.g.:
# ALLOWED_HOSTS=your-app.vercel.app,www.yourgym.com
ALLOWED_HOSTS=
# Primary DB connection. Leave UNSET for the offline SQLite fallback.
# In production this MUST target the Supabase transaction-mode pooler host on port 6543
# (NOT the direct connection on port 5432, and NOT the session pooler).
DATABASE_URL=

# Supabase project URL (Storage integration, deferred).
SUPABASE_URL=
# Supabase API key (Storage integration, deferred).
SUPABASE_KEY=

# PayMongo API auth (billing, deferred).
PAYMONGO_SECRET_KEY=

# PayMongo webhook signature verification secret.
PAYMONGO_WEBHOOK_SECRET=

# Email (Resend). Leave RESEND_API_KEY unset for the offline console backend
# (OTP/invite emails print to the server log). Set it in production for real delivery.
RESEND_API_KEY=
# From address for outbound mail. A verified Resend domain in production.
DEFAULT_FROM_EMAIL=ProFit <onboarding@resend.dev>
# Absolute base URL used to build invite-accept links (management command has no request host).
SITE_BASE_URL=
