/* ProFit admin sidebar.
   One docked panel: brand, grouped navigation, then "Collapse Sidebar" as an ordinary row
   above the account block. Nothing floats on the edge and nothing overlaps the content.
   Loaded last on every admin page so it replaces the older layered sidebar rules. */
:root { --pf-sb-w: 264px; --pf-sb-wc: 84px; --sb-gold: #e8b93a; --sb-gold-2: #f2cb5c; --sb-ink: #1a1407; }

html body nav.sidebar {
  position: fixed; inset: 0 auto 0 0; z-index: 200;
  width: var(--pf-sb-w) !important; box-sizing: border-box; padding: 18px 14px 14px !important;
  display: flex !important; flex-direction: column; gap: 0; overflow: visible !important;
  background: linear-gradient(180deg, #141b27 0%, #0c1119 100%) !important;
  border: 0 !important; border-right: 1px solid rgba(255,255,255,.07) !important; border-radius: 0 24px 24px 0 !important;
  box-shadow: 14px 0 40px rgba(0,0,0,.28) !important;
  transition: width .28s cubic-bezier(.2,.8,.2,1), transform .28s ease !important;
}
html body nav.sidebar.close { width: var(--pf-sb-wc) !important; }
html body nav.sidebar ~ .main-content { margin-left: var(--pf-sb-w) !important; }
html body nav.sidebar.close ~ .main-content { margin-left: var(--pf-sb-wc) !important; }

/* Layout safety: the docked sidebar owns the desktop offset; content must not retain a 100vw width. */
html body .dashboard { min-width: 0; }
html body nav.sidebar ~ .main-content {
  width: auto;
  max-width: none;
  min-width: 0;
  box-sizing: border-box;
}
html body nav.sidebar.close ~ .main-content {
  width: auto;
  max-width: none;
  min-width: 0;
  box-sizing: border-box;
}

/* Brand */
html body nav.sidebar .sidebar-brand-row { flex: 0 0 auto; display: flex; align-items: center; gap: 12px; padding: 4px 6px 16px; margin: 0 0 8px; border-bottom: 1px solid rgba(255,255,255,.07); }
html body nav.sidebar .imgbrand { display: flex; align-items: center; gap: 12px; min-width: 0; text-decoration: none; }
html body nav.sidebar .imgbrand .image { flex: 0 0 42px; width: 42px !important; height: 42px !important; border-radius: 13px; overflow: hidden; }
html body nav.sidebar .headertxt { display: grid; gap: 3px; min-width: 0; }
html body nav.sidebar .headertxt strong { color: #fff; font-size: 16px; font-weight: 800; line-height: 1.1; white-space: nowrap; }
html body nav.sidebar .headertxt small { color: var(--sb-gold); font-size: 10px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; white-space: nowrap; }

/* Navigation (only this region scrolls) */
html body nav.sidebar .sidebar-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; scrollbar-width: none; display: grid; align-content: start; gap: 10px; padding: 4px 0; }
html body nav.sidebar .sidebar-scroll::-webkit-scrollbar { display: none; }
html body nav.sidebar .nav-group { margin: 0; padding: 8px 6px 6px; border-radius: 18px; background: rgba(255,255,255,.035); }
html body nav.sidebar .nav-group-label { margin: 2px 10px 8px; padding: 0; height: auto; opacity: 1; color: #6b778c; font-size: 10.5px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; line-height: 1.2; }
html body nav.sidebar .menulist { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
html body nav.sidebar .menulist li { margin: 0; padding: 0; }

html body nav.sidebar .menulist a,
html body nav.sidebar .sb-collapse {
  position: relative; display: flex; align-items: center; gap: 14px; width: 100%; height: 44px; padding: 0 12px; box-sizing: border-box;
  border: 0; border-radius: 14px; background: transparent !important; box-shadow: none !important;
  color: #98a2b6 !important; font: 600 14px/1 Inter, system-ui, sans-serif !important; text-decoration: none; text-align: left; cursor: pointer;
  transition: background-color .18s ease, color .18s ease;
}
html body nav.sidebar .menulist a .icon,
html body nav.sidebar .sb-collapse .icon { flex: 0 0 22px; width: 22px; text-align: center; font-size: 16px; color: #7f8aa0 !important; display: inline-block !important; visibility: visible !important; opacity: 1 !important; transition: color .18s ease; }
html body nav.sidebar .menulist a .text,
html body nav.sidebar .sb-collapse .text { min-width: 0; font-weight: 600 !important; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: inherit !important; }
html body nav.sidebar .menulist a::before { display: none !important; }

@media (hover: hover) {
  html body nav.sidebar .menulist a:hover,
  html body nav.sidebar .sb-collapse:hover { background: rgba(255,255,255,.07) !important; color: #eef1f7 !important; }
  html body nav.sidebar .menulist a:hover .icon,
  html body nav.sidebar .sb-collapse:hover .icon { color: #eef1f7 !important; }
}
html body nav.sidebar .menulist a:focus-visible,
html body nav.sidebar .sb-collapse:focus-visible,
html body nav.sidebar .account-menu-toggle:focus-visible { outline: 2px solid var(--sb-gold); outline-offset: 2px; }

/* Active page: solid gold pill */
html body nav.sidebar .menulist a.active,
html body nav.sidebar .menulist a.active:hover {
  background: linear-gradient(110deg, var(--sb-gold-2) 0%, var(--sb-gold) 100%) !important; color: var(--sb-ink) !important;
  box-shadow: 0 8px 20px rgba(232,185,58,.22) !important;
}
html body nav.sidebar .menulist a.active .icon,
html body nav.sidebar .menulist a.active .text { color: var(--sb-ink) !important; }

/* Footer: collapse row + account */
html body nav.sidebar .sidebar-foot { flex: 0 0 auto; display: grid; gap: 8px; margin-top: 8px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,.07); }
html body nav.sidebar .sidebar-account { margin: 0 !important; padding: 0 !important; border: 0 !important; position: relative; }
html body nav.sidebar .sidebar-user { position: relative; display: flex; align-items: center; gap: 10px; padding: 8px 8px 8px 10px; border-radius: 16px; background: rgba(255,255,255,.045) !important; border: 0; }
html body nav.sidebar .sidebar-avatar { position: relative; flex: 0 0 38px; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; overflow: hidden; background: linear-gradient(135deg, var(--sb-gold-2), var(--sb-gold)); color: var(--sb-ink); font-weight: 800; font-size: 13px; }
html body nav.sidebar .sidebar-avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
html body nav.sidebar .sidebar-user-copy { flex: 1 1 auto; min-width: 0; display: grid; gap: 2px; }
html body nav.sidebar .sidebar-user-copy strong { color: #fff !important; font-size: 13px !important; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
html body nav.sidebar .sidebar-user-copy small { color: #8b94a5 !important; font-size: 11px !important; line-height: 1.2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
html body nav.sidebar .account-menu-toggle { flex: 0 0 32px; width: 32px; height: 32px; display: grid; place-items: center; border: 0; border-radius: 10px; background: transparent; color: #b4bac7 !important; cursor: pointer; }
html body nav.sidebar .account-menu-toggle:hover { background: rgba(255,255,255,.1); color: #fff !important; }

/* Account menu opens upward inside the panel, so nothing is clipped or overlapped. */
html body nav.sidebar .account-menu {
  position: absolute !important; left: 0 !important; right: 0 !important; bottom: calc(100% + 8px) !important; top: auto !important; width: auto !important;
  display: none; padding: 6px; border-radius: 16px; background: #1a2230 !important; border: 1px solid rgba(255,255,255,.09); box-shadow: 0 18px 40px rgba(0,0,0,.5); z-index: 5;
}
html body nav.sidebar .account-menu.is-open { display: grid !important; gap: 2px; }
html body nav.sidebar .sidebar-user:hover .account-menu:not(.is-open) { display: none !important; }
html body nav.sidebar .account-menu::after { display: none; }
html body nav.sidebar .account-menu a,
html body nav.sidebar .account-menu button { display: flex; align-items: center; gap: 10px; width: 100%; padding: 10px 12px; border: 0; border-radius: 10px; background: transparent !important; color: #dfe4ee !important; font: 600 13px/1 Inter, system-ui, sans-serif; text-align: left; text-decoration: none; cursor: pointer; }
html body nav.sidebar .account-menu a i,
html body nav.sidebar .account-menu button i { width: 16px; text-align: center; color: #98a2b6; }
html body nav.sidebar .account-menu a:hover,
html body nav.sidebar .account-menu button:hover { background: rgba(255,255,255,.08) !important; }
html body nav.sidebar .account-menu button[data-logout],
html body nav.sidebar .account-menu button[data-logout] i { color: #ff7b7b !important; }

/* Collapsed rail: icons only, centred, tooltip on hover */
html body nav.sidebar.close .headertxt,
html body nav.sidebar.close .nav-group-label,
html body nav.sidebar.close .menulist a .text,
html body nav.sidebar.close .sb-collapse .text,
html body nav.sidebar.close .sidebar-user-copy,
html body nav.sidebar.close .account-menu-toggle { display: none !important; }
html body nav.sidebar.close .sidebar-brand-row { justify-content: center; padding: 4px 0 16px; }
html body nav.sidebar.close .imgbrand { justify-content: center; width: 100%; }
html body nav.sidebar.close .nav-group { padding: 6px 4px; background: rgba(255,255,255,.03); }
html body nav.sidebar.close .menulist a,
html body nav.sidebar.close .sb-collapse { justify-content: center; padding: 0; gap: 0; }
html body nav.sidebar.close .sidebar-user { justify-content: center; padding: 6px 0; background: transparent !important; cursor: pointer; }
html body nav.sidebar.close .account-menu { left: calc(100% + 14px) !important; right: auto !important; bottom: 0 !important; width: 210px !important; }

/* Tooltip for the collapsed rail (created in sidebar.js) */
.pf-tip { position: fixed; z-index: 99990; transform: translateY(-50%) translateX(-4px); opacity: 0; pointer-events: none;
  background: #1a2230; color: #fff; border: 1px solid rgba(255,255,255,.1); border-radius: 10px; padding: 8px 12px;
  font: 600 13px/1.2 Inter, system-ui, sans-serif; white-space: nowrap; box-shadow: 0 12px 28px rgba(0,0,0,.45); transition: opacity .15s ease, transform .15s ease; }
.pf-tip.show { opacity: 1; transform: translateY(-50%) translateX(0); }

/* Light theme keeps the dark panel for contrast, so no extra rules are needed. */

/* Phones: the sidebar is a drawer; there is nothing to collapse. */
@media (max-width: 760px) {
  html body nav.sidebar, html body nav.sidebar.close { width: min(300px, 86vw) !important; transform: translateX(-104%); border-radius: 0 24px 24px 0 !important; }
  html body nav.sidebar.mobile-open { transform: translateX(0); }
  html body nav.sidebar ~ .main-content, html body nav.sidebar.close ~ .main-content {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    margin-left: 0 !important;
    box-sizing: border-box;
  }
  html body nav.sidebar .sb-collapse { display: none; }
  html body nav.sidebar.close .headertxt { display: grid !important; }
  html body nav.sidebar.close .nav-group-label, html body nav.sidebar.close .sidebar-user-copy { display: block !important; }
  html body nav.sidebar.close .menulist a .text { display: block !important; }
  html body nav.sidebar.close .account-menu-toggle { display: grid !important; }
  html body nav.sidebar.close .menulist a { justify-content: flex-start; padding: 0 12px; gap: 14px; }
  html body nav.sidebar.close .sidebar-brand-row { justify-content: flex-start; }
  html body nav.sidebar.close .sidebar-user { justify-content: flex-start; padding: 8px 8px 8px 10px; background: rgba(255,255,255,.045) !important; }
  html body nav.sidebar.close .account-menu { left: 0 !important; right: 0 !important; bottom: calc(100% + 8px) !important; width: auto !important; }
}
@media (prefers-reduced-motion: reduce) {
  html body nav.sidebar, html body nav.sidebar .menulist a, html body nav.sidebar .sb-collapse, .pf-tip { transition: none !important; }
}


/* FINAL RESPONSIVE LAYOUT PATCH (2026-10-18)
   The sidebar is fixed-position, so the main area must explicitly occupy only
   the remaining viewport width. A flex:1 main with a left margin can otherwise
   overflow horizontally and appear underneath the sidebar on desktop/tablet. */
html, body { max-width: 100%; overflow-x: clip; }
html body .dashboard { display: block !important; width: 100%; min-width: 0; }
html body .dashboard > main.main-content {
  display: block;
  flex: none !important;
  width: calc(100% - var(--pf-sb-w)) !important;
  max-width: calc(100% - var(--pf-sb-w)) !important;
  min-width: 0 !important;
  margin-left: var(--pf-sb-w) !important;
  margin-right: 0 !important;
  box-sizing: border-box !important;
  overflow-x: clip;
}
html body nav.sidebar.close ~ main.main-content {
  width: calc(100% - var(--pf-sb-wc)) !important;
  max-width: calc(100% - var(--pf-sb-wc)) !important;
  margin-left: var(--pf-sb-wc) !important;
}
html body .main-content > * { min-width: 0; max-width: 100%; }
html body .main-content img,
html body .main-content video,
html body .main-content canvas,
html body .main-content iframe { max-width: 100%; }
@media (max-width: 760px) {
  html body .dashboard { display: block !important; width: 100%; }
  html body .dashboard > main.main-content,
  html body nav.sidebar.close ~ main.main-content {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: clamp(14px, 4vw, 20px);
    padding-right: clamp(14px, 4vw, 20px);
    box-sizing: border-box !important;
    overflow-x: clip;
  }
}
